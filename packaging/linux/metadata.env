# Central Linux distribution metadata. Phase 6 may update product identity here
# without duplicating package names, desktop IDs, or install paths across scripts.
PV_PACKAGE_NAME=pikachu-volleyball-neutralino
PV_DISPLAY_NAME='Pikachu Volleyball'
PV_PACKAGE_VERSION=2.1.0
PV_PACKAGE_RELEASE=1
PV_APPLICATION_ID=com.santirodriguez.pikachuvolleyball.neutralino-spike
PV_MAINTAINER='Santiago Rodriguez <15202529+santirodriguez@users.noreply.github.com>'
PV_HOMEPAGE=https://github.com/santirodriguez/Pikachu-Volleyball
PV_SUMMARY='Pikachu Volleyball desktop game using Neutralino'
PV_INTERNAL_BUNDLE_NAME=pikachu-volleyball-neutralino-production-parity-linux-x64
PV_PORTABLE_BUNDLE_NAME=pikachu-volleyball-neutralino-linux-x64
PV_BINARY_NAME=pikachu-volleyball-neutralino-linux_x64
PV_EXTENSION_NAME=pv-external-link-linux_x64
PV_LAUNCHER_NAME=pikachu-volleyball-neutralino
PV_INSTALL_DIR=/usr/lib/pikachu-volleyball-neutralino
PV_ICON_SOURCE=src/resources/assets/images/IDI_PIKAICON-1_gap_filled_512.png
PV_DEB_ARCH=amd64
PV_RPM_ARCH=x86_64
PV_DEB_DEPENDS='libc6 (>= 2.25), libstdc++6, libgcc-s1, libgtk-3-0 | libgtk-3-0t64, libglib2.0-0 | libglib2.0-0t64, libcairo2, libgdk-pixbuf-2.0-0, libx11-6, libxrandr2, libxtst6, libxcb1, libpng16-16 | libpng16-16t64, libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37, gstreamer1.0-plugins-good, xdg-utils'
PV_RPM_REQUIRES='webkit2gtk4.1 gstreamer1-plugins-good xdg-utils'
